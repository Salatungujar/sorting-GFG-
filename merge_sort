class Solution:
    def merge_array(left, right):
        res = []
        i, j = 0, 0
        n, m = len(left), len(right)
        while i < n and j < m:
            if left[i] <= right[j]:
                res.append(left[i])
                i += 1
            else:
                res.append(right[j])
                j += 1
                
        while i < n:
            res.append(left[i])
            i += 1
                
        while j < m:
            res.append(right[j])
            j += 1
                
        return res
        
    def mergeSort(self, arr, l, r):
        # code here
        if len(arr) <= 1:
            return arr
        
        mid = len(arr)//2
        left_arr = arr[:mid]
        right_arr = arr[mid:]
        
        left = self.mergeSort(left_arr, 0 , len(left_arr) - 1)
        right = self.mergeSort(right_arr, 0, len(right_arr) - 1)
        
        return self.merge_array(left, right)
